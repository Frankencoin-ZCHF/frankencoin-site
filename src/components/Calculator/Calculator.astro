---
/**
 * "What if" calculator. Server-reads live data (utils/calcStats.ts), injects it as JSON and lets an
 * Alpine component do the arithmetic. Used on the home page, /start and /save-invest.
 *
 * Props:
 *   - compact?: boolean   hide the eyebrow/title (the surrounding section already has one)
 *   - defaultGoal?: "save" | "invest"
 */
import { getLanguageFromURL, loadContent, getLocalizedPath } from "../../utils/i18n";
import { getCalcData } from "../../utils/calcStats";

interface Props {
  compact?: boolean;
  defaultGoal?: "save" | "invest";
}
const { compact = false, defaultGoal = "save" } = Astro.props as Props;

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("calculator", lang);
const data = await getCalcData();
const ok = data.fps.length > 0 && data.rates.length > 0 && data.current.fpsPrice !== null;

const locale = lang === "de" ? "de-CH" : "en-CH";
const investHref = c.cta.invest.href.startsWith("/") ? getLocalizedPath(c.cta.invest.href, lang) : c.cta.invest.href;
const payload = JSON.stringify({ data, copy: c, locale, defaultGoal, investHref });
---

<div
  class="calc rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-white)] shadow-sm p-5 sm:p-8 overflow-hidden min-w-0"
  x-data="frankCalc()"
  x-init="init($el.dataset.calc)"
  data-calc={payload}
>

  {!compact && (
    <div class="mb-6 text-center">
      <p class="ty-subtitle">{c.eyebrow.toUpperCase()}</p>
      <h2 class="ty-title-1 text-[var(--color-brand-deep-blue)] mt-1">{c.title}</h2>
      <p class="ty-body-2 text-[var(--color-neutral-650)] mt-2">{c.subtitle}</p>
    </div>
  )}

  {!ok ? (
    <p class="ty-body-2 text-center text-[var(--color-neutral-550)]">{c.unavailable}</p>
  ) : (
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-6 lg:gap-10 min-w-0">
      <!-- Inputs -->
      <div class="flex flex-col gap-5 min-w-0">
        <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-[var(--color-gray-15)]" role="tablist">
          <template x-for="g in ['save','invest']" :key="g">
            <button
              type="button"
              role="tab"
              :aria-selected="goal === g"
              @click="goal = g"
              class="rounded-lg px-3 py-3 text-left transition-colors min-w-0"
              :class="goal === g ? 'bg-[var(--color-white)] shadow-sm text-[var(--color-brand-deep-blue)]' : 'text-[var(--color-neutral-600)] hover:text-[var(--color-brand-deep-blue)]'"
            >
              <span class="block ty-body-2 font-bold" x-text="copy.goals[g].label"></span>
              <span class="block ty-2xs mt-0.5 text-[var(--color-neutral-550)] leading-snug" x-text="hint(g)"></span>
            </button>
          </template>
        </div>

        <label class="flex flex-col gap-2 min-w-0">
          <span class="ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]" x-text="copy.amount.toUpperCase()"></span>
          <span class="flex min-w-0 rounded-xl border border-[var(--color-gray-20)] overflow-hidden focus-within:border-[var(--color-brand-swiss)]">
            <input
              type="text"
              inputmode="decimal"
              size="6"
              class="w-full min-w-0 flex-1 px-4 py-3 ty-title-2 font-bold text-[var(--color-brand-deep-blue)] outline-none bg-transparent"
              :value="fmtInput(amount)"
              @input="amount = parse($event.target.value)"
              @blur="$event.target.value = fmtInput(amount)"
            />
            <select x-model="currency" class="px-3 ty-body-2 font-bold bg-[var(--color-gray-15)] text-[var(--color-brand-deep-blue)] border-l border-[var(--color-gray-20)] outline-none">
              <option value="CHF">CHF</option>
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
            </select>
          </span>
        </label>
        <div class="flex flex-wrap gap-2 -mt-2">
          <template x-for="p in copy.presets" :key="p">
            <button type="button" @click="amount = p" class="rounded-full border px-3 py-1 ty-xs font-bold transition-colors"
              :class="amount === p ? 'border-[var(--color-brand-deep-blue)] bg-[var(--color-brand-deep-blue)] text-white' : 'border-[var(--color-gray-20)] text-[var(--color-neutral-600)] hover:border-[var(--color-brand-deep-blue)]'"
              x-text="fmtInput(p)"></button>
          </template>
        </div>

        <div class="flex flex-col gap-2">
          <span class="ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]" x-text="copy.since.toUpperCase()"></span>
          <div class="grid grid-cols-3 gap-2">
            <template x-for="y in [1,2,3]" :key="y">
              <button type="button" @click="years = y" class="rounded-xl border px-3 py-2 ty-body-3 font-bold transition-colors"
                :class="years === y ? 'border-[var(--color-brand-deep-blue)] bg-[var(--color-brand-deep-blue)] text-white' : 'border-[var(--color-gray-20)] text-[var(--color-neutral-600)] hover:border-[var(--color-brand-deep-blue)]'"
                x-text="agoLabel(y)"></button>
            </template>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="flex flex-col gap-4 min-w-0">
        <div class="rounded-2xl bg-[var(--color-brand-deep-blue)] text-white p-5 sm:p-6 relative overflow-hidden">
          <p class="ty-xs tracking-wider font-bold opacity-80" x-text="copy.result.then.toUpperCase()"></p>
          <p class="text-[34px] sm:text-[44px] font-black mt-1 leading-none break-words" x-text="money(r.now)"></p>
          <p class="ty-body-2 mt-2 opacity-90">
            <span x-text="copy.result.start + ' ' + money(r.start)"></span>
            <span class="mx-1">·</span>
            <span x-text="copy.result.gain"></span>
            <span class="font-bold" :class="r.gainPct >= 0 ? 'text-[#7ee2a8]' : 'text-[#ff9a9a]'" x-text="signed(r.gainPct)"></span>
          </p>
          <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="w-full h-16 mt-4 opacity-90" aria-hidden="true">
            <path :d="r.area" fill="rgba(255,255,255,0.14)"></path>
            <path :d="r.line" fill="none" stroke="#ffffff" stroke-width="1.2" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>

        <div class="rounded-2xl border border-[var(--color-gray-20)] p-5">
          <p class="ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]" x-text="projectedLabel().toUpperCase()"></p>
          <p class="ty-title-1 font-black text-[var(--color-brand-deep-blue)] mt-1" x-text="money(r.projected)"></p>
          <p class="ty-xs text-[var(--color-neutral-550)] mt-1" x-text="copy.sources.projectedNote"></p>
        </div>

        <a :href="goal === 'save' ? copy.cta.save.href : investHref" :target="goal === 'save' ? '_blank' : null" rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-brand-swiss)] hover:bg-[var(--color-blue-39)] text-white font-bold ty-body-2 px-6 py-4 transition-colors">
          <span x-text="goal === 'save' ? copy.cta.save.label : copy.cta.invest.label"></span>
          <img src="/images/Arrow.svg" alt="" class="w-3 h-3 invert" />
        </a>

        <p class="ty-2xs text-[var(--color-neutral-550)] leading-snug">
          <span x-text="goal === 'save' ? copy.sources.save : copy.sources.invest"></span>
          <span x-show="r.partial" x-text="' ' + partialNote()"></span>
          <span x-show="currency !== 'CHF'" x-text="' ' + copy.sources.fx"></span>
        </p>
      </div>
    </div>
  )}
</div>

<script is:inline>
  function frankCalc() {
    return {
      data: null, copy: {}, locale: "en-CH", investHref: "#",
      goal: "save", amount: 5000, currency: "CHF", years: 1,
      r: { start: 0, now: 0, gainPct: 0, projected: 0, line: "", area: "", partial: false },
      init(json) {
        if (!json || this.data) return;
        const p = JSON.parse(json);
        this.data = p.data; this.copy = p.copy; this.locale = p.locale; this.goal = p.defaultGoal; this.investHref = p.investHref;
        this.$watch("goal", () => this.compute());
        this.$watch("amount", () => this.compute());
        this.$watch("currency", () => this.compute());
        this.$watch("years", () => this.compute());
        this.compute();
      },
      // ---- formatting
      fx() { return this.data?.fx?.[this.currency] ?? 1; },
      money(chf) {
        const v = chf * this.fx();
        const s = new Intl.NumberFormat(this.locale, { maximumFractionDigits: 0 }).format(Math.round(v));
        return `${s} ${this.currency}`;
      },
      fmtInput(n) { return new Intl.NumberFormat(this.locale, { maximumFractionDigits: 0 }).format(n); },
      parse(s) { const n = Number(String(s).replace(/[^\d.]/g, "")); return Number.isFinite(n) && n > 0 ? Math.min(n, 1e9) : 0; },
      signed(p) { return `${p >= 0 ? "+" : "−"}${Math.abs(p * 100).toFixed(1)}%`; },
      pct(f) { return `${(f * 100).toFixed(2).replace(/\.?0+$/, "")}%`; },
      hint(g) {
        const h = this.copy.goals[g].hint;
        return g === "save" ? h.replace("{rate}", this.pct(this.data.current.rate ?? 0)) : h;
      },
      agoLabel(y) { return (y === 1 ? this.copy.ago : this.copy.agoPlural).replace("{n}", y); },
      projectedLabel() {
        const what = this.goal === "save" ? this.copy.result.projectedWhatSave : this.copy.result.projectedWhatInvest;
        const tpl = this.years === 1 ? this.copy.result.projectedSingular ?? this.copy.result.projected : this.copy.result.projected;
        return tpl.replace("{n}", this.years).replace("{what}", what);
      },
      partialNote() {
        const first = this.data.rates[0]?.[0];
        if (!first) return "";
        const d = new Date(first * 1000).toLocaleDateString(this.locale, { month: "long", year: "numeric" });
        return this.copy.sources.noHistory.replace("{date}", d);
      },
      // ---- maths (all in CHF; fiat only at display time)
      rateAt(ts) {
        let r = 0;
        for (const [t, v] of this.data.rates) { if (t <= ts) r = v; else break; }
        return r;
      },
      priceAt(ts) {
        const s = this.data.fps;
        let p = s[0][1];
        for (const [t, v] of s) { if (t <= ts) p = v; else break; }
        return p;
      },
      compute() {
        if (!this.data) return;
        const amtChf = this.amount / this.fx();
        const now = this.data.current.updated ?? Math.floor(Date.now() / 1000);
        const from = now - this.years * 365 * 86400;
        const N = 48;
        const pts = [];
        let partial = false;
        if (this.goal === "save") {
          // Daily compounding at whatever rate applied each day.
          let v = amtChf;
          const step = (now - from) / N;
          pts.push(v);
          for (let i = 1; i <= N; i++) {
            const a = from + (i - 1) * step, b = from + i * step;
            for (let t = a; t < b; t += 86400) {
              const r = this.rateAt(t);
              v *= 1 + (r * Math.min(86400, b - t)) / (365 * 86400);
            }
            pts.push(v);
          }
          partial = this.rateAt(from) === 0;
          const cur = this.data.current.rate ?? 0;
          this.finish(amtChf, v, pts, amtChf * Math.pow(1 + cur, this.years), partial);
        } else {
          const p0 = this.priceAt(from);
          const shares = amtChf / p0;
          for (let i = 0; i <= N; i++) pts.push(shares * this.priceAt(from + ((now - from) * i) / N));
          const v = shares * (this.data.current.fpsPrice ?? this.priceAt(now));
          partial = this.data.fps[0][0] > from;
          const roe = this.data.current.roe12m ?? 0;
          this.finish(amtChf, v, pts, amtChf * Math.pow(1 + roe, this.years), partial);
        }
      },
      finish(start, now, pts, projected, partial) {
        const min = Math.min(...pts), max = Math.max(...pts), span = max - min || 1;
        const xy = pts.map((v, i) => [(i / (pts.length - 1)) * 100, 30 - ((v - min) / span) * 26]);
        const line = xy.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(2)} ${y.toFixed(2)}`).join(" ");
        this.r = { start, now, gainPct: start ? now / start - 1 : 0, projected, line, area: `${line} L100 32 L0 32 Z`, partial };
      },
    };
  }
</script>
