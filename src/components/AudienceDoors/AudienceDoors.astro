---
/**
 * Three "doors" under the hero: who are you, where should you go.
 * Props: doors: { eyebrow, title, body, cta, href, stat?: { value, label } }[]
 */
import { getLanguageFromURL, getLocalizedPath } from "../../utils/i18n";

interface Door { eyebrow: string; title: string; body: string; cta: string; href: string; stat?: { value: string; label: string } }
const { doors } = Astro.props as { doors: Door[] };
const lang = getLanguageFromURL(Astro.url.pathname);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
---

<div class="grid md:grid-cols-3 gap-4 lg:gap-6">
  {doors.map((d) => (
    <a
      href={href(d.href)}
      class="group flex flex-col gap-3 rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-white)] p-6 lg:p-8 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg hover:border-[var(--color-brand-swiss)]"
    >
      <p class="ty-xs tracking-wider font-bold text-[var(--color-brand-swiss)]">{d.eyebrow.toUpperCase()}</p>
      <h3 class="ty-title-2 font-black text-[var(--color-brand-deep-blue)] m-0">{d.title}</h3>
      {d.stat && (
        <p class="flex items-baseline gap-2">
          <span class="ty-big-2 font-black text-[var(--color-brand-deep-blue)]">{d.stat.value}</span>
          <span class="ty-xs text-[var(--color-neutral-550)]">{d.stat.label}</span>
        </p>
      )}
      <p class="ty-body-2 text-[var(--color-neutral-650)] flex-1">{d.body}</p>
      <span class="inline-flex items-center gap-2 ty-body-2 font-bold text-[var(--color-brand-deep-blue)] group-hover:text-[var(--color-brand-swiss)]">
        {d.cta}
        <img src="/images/Arrow.svg" alt="" class="w-3 h-3 transition-transform group-hover:translate-x-0.5" />
      </span>
    </a>
  ))}
</div>
