---
/**
 * Mobile-only sticky bottom bar with one primary action. Hidden while the hero is on screen.
 * Props: label, href, sub?
 */
import { getLanguageFromURL, getLocalizedPath } from "../../utils/i18n";
const { label, href, sub } = Astro.props as { label: string; href: string; sub?: string };
const lang = getLanguageFromURL(Astro.url.pathname);
const url = href.startsWith("/") ? getLocalizedPath(href, lang) : href;
const ext = href.startsWith("http");
---

<div
  id="sticky-cta"
  class="md:hidden fixed inset-x-0 bottom-0 z-30 px-4 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 bg-[color-mix(in_oklab,var(--color-white)_92%,transparent)] backdrop-blur border-t border-[var(--color-gray-20)] translate-y-full transition-transform duration-300"
  data-visible="false"
>
  <a
    href={url}
    target={ext ? "_blank" : undefined}
    rel={ext ? "noopener noreferrer" : undefined}
    class="flex items-center justify-between rounded-full bg-[var(--color-brand-swiss)] text-white px-6 py-4 font-bold ty-body-2 shadow-lg"
  >
    <span class="flex flex-col leading-tight">
      <span>{label}</span>
      {sub && <span class="ty-2xs font-medium opacity-90">{sub}</span>}
    </span>
    <img src="/images/Arrow.svg" alt="" class="w-3 h-3 invert" />
  </a>
</div>

<script is:inline>
  (function () {
    const bar = document.getElementById("sticky-cta");
    const hero = document.querySelector("[data-hero]");
    if (!bar) return;
    const show = (v) => bar.classList.toggle("translate-y-full", !v);
    if (!hero || !("IntersectionObserver" in window)) { show(true); return; }
    new IntersectionObserver(([e]) => show(!e.isIntersecting), { threshold: 0.15 }).observe(hero);
  })();
</script>
