---
/*
 * /partners — audience page for businesses and integrators. Copy: src/content/en/partners.json.
 */
import Base from "../layouts/Base.astro";
import Section from "../components/Layout/Section.astro";
import AudienceDoors from "../components/AudienceDoors/AudienceDoors.astro";
import { getLanguageFromURL, loadContent, getLocalizedPath } from "../utils/i18n";

export const prerender = false;

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("partners", lang);
const eco = await loadContent<any>("ecosystem", lang);
const logos = (eco.tabs ?? []).filter((t: any) => t.image).slice(0, 12);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
---

<Base title={c.meta.title} description={c.meta.description}>
  <Section id="partners-hero" variant="accent" pad="xs" margin="mt-16">
    <div class="pt-8 md:pt-12 max-w-3xl flex flex-col gap-5">
      <p class="ty-subtitle">{c.hero.eyebrow.toUpperCase()}</p>
      <h1 class="ty-large-title text-[var(--color-brand-deep-blue)] m-0">{c.hero.title}</h1>
      <p class="ty-body-1 text-[var(--color-neutral-650)]">{c.hero.subtitle}</p>
      <div class="flex flex-wrap gap-3">
        <a href={c.hero.primary.href} class="inline-flex items-center rounded-full bg-[var(--color-brand-swiss)] hover:bg-[var(--color-blue-39)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">{c.hero.primary.label}</a>
        <a href={c.hero.secondary.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full border border-[var(--color-brand-deep-blue)] text-[var(--color-brand-deep-blue)] font-bold ty-body-2 px-6 py-3.5 hover:bg-[var(--color-white)]">{c.hero.secondary.label}</a>
      </div>
    </div>
    <div class="mt-10 md:mt-14"><AudienceDoors doors={c.doors} /></div>
  </Section>

  <Section id="why" title={c.why.title} pad="xs" align="center">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 text-left">
      {c.why.items.map((it: any) => (
        <div class="rounded-2xl border border-[var(--color-gray-20)] p-6 flex flex-col gap-2">
          <h3 class="ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{it.title}</h3>
          <p class="ty-body-3 text-[var(--color-neutral-650)]">{it.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="logos" variant="accent" title={c.logos.title} pad="xs" align="center">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {logos.map((t: any) => (
        <a href={t.href} target="_blank" rel="noopener noreferrer" title={t.name} class="flex items-center justify-center rounded-xl bg-[var(--color-white)] border border-[var(--color-gray-20)] p-4 h-20 hover:border-[var(--color-brand-swiss)] transition-colors">
          <img src={t.image} alt={t.imageAlt ?? t.name} loading="lazy" class="max-h-10 max-w-full object-contain" />
        </a>
      ))}
    </div>
  </Section>

  <Section id="contact" pad="xs" align="center">
    <div class="max-w-2xl mx-auto rounded-3xl bg-[var(--color-brand-deep-blue)] text-white p-8 md:p-12 flex flex-col gap-4 items-center">
      <h2 class="ty-title-1 font-black m-0">{c.cta.title}</h2>
      <p class="ty-body-2 opacity-90">{c.cta.body}</p>
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        <a href={c.cta.primary.href} class="inline-flex items-center rounded-full bg-[var(--color-brand-swiss)] hover:bg-white hover:text-[var(--color-brand-deep-blue)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">{c.cta.primary.label}</a>
        <a href={c.cta.secondary.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full border border-white/60 text-white font-bold ty-body-2 px-6 py-3.5 hover:bg-white/10">{c.cta.secondary.label}</a>
      </div>
    </div>
  </Section>
</Base>
