---
/*
 * /save-invest — audience page for savers and investors. Copy: src/content/en/save-invest.json.
 */
import Base from "../layouts/Base.astro";
import Section from "../components/Layout/Section.astro";
import Calculator from "../components/Calculator/Calculator.astro";
import TrustStrip from "../components/TrustStrip/TrustStrip.astro";
import StickyCTA from "../components/StickyCTA/StickyCTA.astro";
import ExplanationCardsContainer from "../components/ExplanationCardsContainer/ExplanationCardsContainer.astro";
import { getLanguageFromURL, loadContent, getLocalizedPath } from "../utils/i18n";
import { getCalcData } from "../utils/calcStats";
import { formatAmount, formatPct } from "../utils/fcsStats";

export const prerender = false;

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("save-invest", lang);
const d = await getCalcData();
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
const figures = [
  { ...c.figures.rate, value: formatPct(d.current.rate, 2) },
  { ...c.figures.saved, value: formatAmount(d.current.totalSavings) },
  { ...c.figures.roe, value: formatPct(d.current.roe12m, 1) },
  { ...c.figures.price, value: formatAmount(d.current.fpsPrice) },
];
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description}>
  <Section id="si-hero" variant="accent" pad="xs" margin="mt-16">
    <div data-hero class="pt-8 md:pt-12 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
      <div class="flex flex-col gap-5">
        <p class="ty-subtitle">{c.hero.eyebrow.toUpperCase()}</p>
        <h1 class="ty-large-title text-[var(--color-brand-deep-blue)] m-0">{c.hero.title}</h1>
        <p class="ty-body-1 text-[var(--color-neutral-650)]">{c.hero.subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a href={href(c.hero.primary.href)} class="inline-flex items-center rounded-full bg-[var(--color-brand-swiss)] hover:bg-[var(--color-blue-39)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">{c.hero.primary.label}</a>
          <a href={c.hero.secondary.href} class="inline-flex items-center rounded-full border border-[var(--color-brand-deep-blue)] text-[var(--color-brand-deep-blue)] font-bold ty-body-2 px-6 py-3.5 hover:bg-[var(--color-white)]">{c.hero.secondary.label}</a>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-3 m-0">
        {figures.map((f) => (
          <div class="rounded-2xl bg-[var(--color-white)] border border-[var(--color-gray-20)] p-5">
            <dt class="ty-xs tracking-wider font-bold text-[var(--color-neutral-550)]">{f.label.toUpperCase()}</dt>
            <dd class="m-0 mt-1 ty-title-1 font-black text-[var(--color-brand-deep-blue)] leading-none">{f.value}</dd>
            <dd class="m-0 mt-1 ty-xs text-[var(--color-neutral-550)]">{f.unit}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section id="calculator" pad="xs">
    <div class="max-w-5xl mx-auto"><Calculator /></div>
  </Section>

  <Section id="compare" variant="accent" title={c.compare.title} subtitle={c.compare.subtitle} pad="xs" align="center">
    <div class="max-w-4xl mx-auto overflow-x-auto text-left">
      <table class="w-full border-separate border-spacing-0 rounded-2xl overflow-hidden border border-[var(--color-gray-20)] bg-[var(--color-white)] ty-body-3">
        <thead>
          <tr class="bg-[var(--color-gray-15)]">
            <th class="text-left p-4"></th>
            <th class="text-left p-4 ty-body-2 font-black text-[var(--color-brand-deep-blue)]">ZCHF savings</th>
            <th class="text-left p-4 ty-body-2 font-black text-[var(--color-brand-deep-blue)]">FCS</th>
          </tr>
        </thead>
        <tbody>
          {c.compare.rows.map((r: any) => (
            <tr class="border-t border-[var(--color-gray-20)]">
              <th scope="row" class="text-left p-4 font-bold text-[var(--color-neutral-600)] border-t border-[var(--color-gray-20)]">{r.label}</th>
              <td class="p-4 border-t border-[var(--color-gray-20)] text-[var(--color-neutral-700)]">{r.save}</td>
              <td class="p-4 border-t border-[var(--color-gray-20)] text-[var(--color-neutral-700)]">{r.invest}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="how" title={c.how.title} pad="xs" align="center">
    <ExplanationCardsContainer cards={c.how.cards} />
  </Section>

  <Section id="trust" variant="accent" title={c.trust.title} pad="xs" align="center">
    <div class="max-w-5xl mx-auto text-left"><TrustStrip items={c.trust.items} /></div>
  </Section>

  <StickyCTA label={c.sticky.label} sub={c.sticky.sub} href="/start" />
</Base>
