---
import Section from "../components/Layout/Section.astro";
import SectionHeader from "../components/Layout/SectionHeader.astro";
import Base from "../layouts/Base.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const insurance = await loadContent("insurance", currentLang);
---

<Base title={insurance.seo.title} description={insurance.seo.description}>
  <Section variant="accent" align="left" pad="xs" id="insurance-header">
    <div class="max-w-4xl mx-auto">
      <SectionHeader
        eyebrow={insurance.header.eyebrow}
        title={insurance.header.title}
        subtitle={insurance.header.subtitle}
        maxWidth="2xl"
        size="display"
        align="center"
        margin="none"
        padding="md"
      />
    </div>
  </Section>

  {insurance.products.map((product: any) => (
    <Section variant="plain" align="left" pad="xs" id="depeg-cover">
      <div class="max-w-5xl mx-auto">
        <div class="rounded-2xl border border-[var(--color-neutral-200)] bg-white p-[var(--spacing-xl)] md:p-[var(--spacing-xxl)] shadow-sm">
          <!-- Product header -->
          <span class="inline-block rounded-full bg-[var(--color-brand-deep-blue)] text-white ty-small font-bold px-3 py-1 mb-4">
            {product.badge}
          </span>
          <h2 class="ty-big-1 text-[var(--color-brand-deep-blue)] mb-2">{product.title}</h2>
          <p class="ty-body-1 text-[var(--color-brand-swiss)] font-semibold mb-6">{product.provider}</p>
          <p class="ty-body-1 text-[var(--color-brand-titan-gray)] leading-relaxed mb-8 max-w-3xl">
            {product.description}
          </p>

          <!-- Highlights -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
            {product.highlights.map((h: any) => (
              <div class="rounded-xl bg-[var(--color-gray-10)] p-5">
                <p class="ty-small text-[var(--color-brand-titan-gray)] mb-1">{h.label}</p>
                <p class="ty-regular font-bold text-[var(--color-brand-deep-blue)]">{h.value}</p>
              </div>
            ))}
          </div>

          <!-- Covered / Not covered -->
          <div class="grid md:grid-cols-2 gap-6 mb-10">
            <div class="rounded-xl border border-green-200 bg-green-50/60 p-6">
              <h3 class="ty-big-2 text-[var(--color-brand-deep-blue)] mb-4">{product.covered.title}</h3>
              <ul class="flex flex-col gap-3">
                {product.covered.items.map((item: string) => (
                  <li class="flex items-start gap-3 ty-body-2 text-[var(--color-brand-titan-gray)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-green-600 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-xl border border-[var(--color-neutral-200)] bg-[var(--color-gray-10)] p-6">
              <h3 class="ty-big-2 text-[var(--color-brand-deep-blue)] mb-4">{product.excluded.title}</h3>
              <ul class="flex flex-col gap-3">
                {product.excluded.items.map((item: string) => (
                  <li class="flex items-start gap-3 ty-body-2 text-[var(--color-brand-titan-gray)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-[var(--color-brand-titan-gray)] mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM6.28 6.28a.75.75 0 011.06 0L10 8.94l2.66-2.66a.75.75 0 111.06 1.06L11.06 10l2.66 2.66a.75.75 0 11-1.06 1.06L10 11.06l-2.66 2.66a.75.75 0 01-1.06-1.06L8.94 10 6.28 7.34a.75.75 0 010-1.06z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- How it works -->
          <div class="mb-10">
            <h3 class="ty-big-2 text-[var(--color-brand-deep-blue)] mb-4">{product.howItWorks.title}</h3>
            <ol class="grid md:grid-cols-3 gap-4">
              {product.howItWorks.steps.map((step: string, i: number) => (
                <li class="rounded-xl border border-[var(--color-neutral-200)] p-5">
                  <div class="w-8 h-8 rounded-full bg-[var(--color-brand-deep-blue)] text-white flex items-center justify-center font-bold ty-small mb-3">
                    {i + 1}
                  </div>
                  <p class="ty-body-2 text-[var(--color-brand-titan-gray)]">{step}</p>
                </li>
              ))}
            </ol>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <a
              href={product.cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[var(--color-brand-deep-blue)] text-white px-6 py-3 rounded-lg ty-regular font-bold hover:bg-[var(--color-brand-swiss)] transition-colors"
            >
              <span>{product.cta.label}</span>
              <img src="/images/Arrow.svg" loading="lazy" alt="" class="w-3 h-3 invert" />
            </a>
            <a
              href={product.learnMore.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 ty-regular font-semibold text-[var(--color-brand-deep-blue)] hover:text-[var(--color-brand-swiss)] hover:underline"
            >
              <span>{product.learnMore.label}</span>
            </a>
          </div>
        </div>
      </div>
    </Section>
  ))}

  <!-- Disclaimer -->
  <Section id="insurance-disclaimer" variant="plain">
    <div class="max-w-4xl mx-auto">
      <div class="bg-[var(--color-gray-10)] rounded-xl p-6 border-l-4 border-[var(--color-brand-titan-gray)]">
        <h3 class="ty-regular font-bold text-[var(--color-brand-titan-gray)] mb-2">{insurance.disclaimer.title}</h3>
        <p class="ty-small text-[var(--color-brand-titan-gray)]">{insurance.disclaimer.text}</p>
      </div>
    </div>
  </Section>
</Base>
