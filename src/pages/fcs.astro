---
/*
 * FCS (Frankencoin Shares) landing page: /fcs and /de/fcs.
 * Copy: src/content/{en,de}/fcs.json (English copy is checked by `yarn lint:fcs`).
 * Live figures: src/utils/fcsStats.ts (server-side, 5-minute cache).
 * Styles: src/styles/fcs.css.
 */
import Base from "../layouts/Base.astro";
import PixelIcon from "../components/Fcs/PixelIcon.astro";
import PixelSwissFlag from "../components/Fcs/PixelSwissFlag.astro";
import type { IconName } from "../components/Fcs/pixelArt";
import { getLanguageFromURL, loadContent } from "../utils/i18n";
import { FCS_ADDRESS, formatAmount, formatPct, formatStamp, getFcsStats } from "../utils/fcsStats";
import "../styles/fcs.css";

export const prerender = false;

type Card = { title: string; body: string };
type Copy = {
  meta: { title: string; description: string };
  nav: { label: string; href: string }[];
  cta: { uniswap: string; matcha: string };
  ama: { eyebrow: string; title: string; cta: string; local: string; close: string };
  hero: {
    brand: { name: string; full: string };
    headline: string;
    sub: string;
    figures: Record<"price" | "pool" | "roe", { label: string; unit: string }>;
    stamp: string;
    stampUnavailable: string;
  };
  what: { headline: string; cards: Card[] };
  why: { headline: string; intro: string; cards: Card[] };
  buy: {
    headline: string;
    uniswap: { title: string; body: string };
    matcha: { title: string; body: string };
    contractCheck: string;
    copy: string;
    copied: string;
    proof: Record<"title" | "audited" | "openSource" | "onChain" | "audit" | "github" | "docs" | "contract" | "pool" | "dune", string>;
  };
  franc: { headline: string; paragraphs: string[]; closing: string; flagAlt: string };
  zchf: { headline: string; intro: string; coinAlt: string; cards: Card[]; emphasis: string };
  faq: { headline: string; items: { q: string; a: string }[] };
  disclaimer: string;
};

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<Copy>("fcs", lang);
const stats = await getFcsStats();

const links = {
  /** Primary CTA: Uniswap with FCS as output; the router finds the path from any input token. */
  uniswap: `https://app.uniswap.org/swap?chain=mainnet&outputCurrency=${FCS_ADDRESS}`,
  /** Matcha (0x aggregator) buying FCS, selling USDT by default. Link supplied by the Frankencoin team. */
  matcha: `https://matcha.xyz/?buyAddress=${FCS_ADDRESS.toLowerCase()}&buyChain=1&sellAddress=0xdac17f958d2ee523a2206206994597c13d831ec7&sellChain=1`,
  pool: "https://app.uniswap.org/explore/pools/ethereum/0xcD795ae77A7318A396D6645bAf0562d8a0312323",
  contract: `https://etherscan.io/address/${FCS_ADDRESS.toLowerCase()}`,
  audit: "https://reports.chainsecurity.com/Frankencoin/ChainSecurity_Frankencoin_FPS2_Audit.pdf",
  docs: "https://docs.frankencoin.com/pool-shares/fcs",
  github: "https://github.com/Frankencoin-ZCHF",
  dune: "https://dune.com/frankencoin",
};

/*
 * FCS launch AMA on X Spaces. Start time from the public Frankencoin calendar event
 * (DTSTART 20261001T170000Z = Thu 1 Oct 2026, 19:00 Zurich time, CEST).
 * The reminder is only rendered before the start; the page script also removes it at the start
 * time, in case a cached page stays open.
 */
const AMA_START = "2026-10-01T17:00:00Z";
const AMA_CALENDAR =
  "https://calendar.google.com/calendar/event?action=TEMPLATE&tmeid=MnQyZW12MW1jbDQ4Y284bDk5ODFpNjlsbm0gY18wNTZmZmEwZGY2ZDIyNzNlNDU0ZWRjYjQ5ZTllNjkzYWY5ZGIyNjM1ODIzYzQzNDIzYjc1ZjZiMzlkMDg1N2RlQGc&tmsrc=c_056ffa0df6d2273e454edcb49e9e693af9db2635823c43423b75f6b39d0857de%40group.calendar.google.com";
const showAma = Date.now() < Date.parse(AMA_START);
const amaWhen = new Intl.DateTimeFormat(lang === "de" ? "de-CH" : "en-GB", {
  weekday: "short",
  day: "numeric",
  month: "long",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Zurich",
  timeZoneName: "short",
}).format(new Date(AMA_START));

const UNI = "/images/fcs/uniswap-pink.svg"; // Uniswap/brand-assets, Uniswap_icon_pink.svg
const MATCHA = "/images/fcs/matcha.svg"; // matcha.xyz/favicon.svg

const figures = [
  { ...c.hero.figures.price, value: formatAmount(stats.fcsPrice, 2) },
  { ...c.hero.figures.pool, value: formatAmount(stats.reservePool) },
  { ...c.hero.figures.roe, value: formatPct(stats.roe12m) },
];
const stamp = formatStamp(c.hero.stamp, stats.block, stats.timestamp);

const whatIcons: IconName[] = ["pie", "ballot"];
const whyIcons: IconName[] = ["coins", "lock", "bars", "shield"];

const buyOptions = [
  { k: "uniswap", card: c.buy.uniswap, action: c.cta.uniswap, logo: UNI, href: links.uniswap, event: "cta_get_fcs", btn: "fcs-btn-blue" },
  { k: "matcha", card: c.buy.matcha, action: c.cta.matcha, logo: MATCHA, href: links.matcha, event: "cta_swap_matcha", btn: "fcs-btn-dark" },
];

const proof = [
  { label: c.buy.proof.audited, items: [{ key: "audit", label: c.buy.proof.audit, url: links.audit }] },
  {
    label: c.buy.proof.openSource,
    items: [
      { key: "github", label: c.buy.proof.github, url: links.github },
      { key: "docs", label: c.buy.proof.docs, url: links.docs },
    ],
  },
  {
    label: c.buy.proof.onChain,
    items: [
      { key: "contract", label: c.buy.proof.contract, url: links.contract },
      { key: "pool", label: c.buy.proof.pool, url: links.pool },
      { key: "dune", label: c.buy.proof.dune, url: links.dune },
    ],
  },
];

/*
 * Hero art box: never wider than 2.1x the viewport height (the same ratio as the media query, so the cap and the
 * fade start together), centered. On ultrawide screens the image would otherwise scale with the width and push the
 * peaks into the text; capped, its sides fade into white (eased stops, longer on the brighter right side).
 */
const ART_BOX =
  "relative mx-auto h-full max-w-[210svh] [@media(min-aspect-ratio:21/10)]:[mask-image:linear-gradient(90deg,transparent_0%,rgba(0,0,0,0.12)_5%,rgba(0,0,0,0.4)_11%,rgba(0,0,0,0.75)_17%,#000_24%,#000_62%,rgba(0,0,0,0.75)_72%,rgba(0,0,0,0.4)_82%,rgba(0,0,0,0.12)_92%,transparent_100%)]";
const ART_SIZES = "(min-aspect-ratio: 21/10) 210vh, 100vw";
const srcset = (name: string) => [828, 1280, 2000].map((w) => `/images/fcs/${name}-${w}.webp ${w}w`).join(", ");

// FAQ as structured data, for search engines and AI answers.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: c.faq.items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })),
};

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description} image="/images/fcs/og.png" navLinks={c.nav} footerNote={c.disclaimer}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" imagesrcset={srcset("mountains-back")} imagesizes={ART_SIZES} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div id="fcs-page" class="pt-[65px] text-[var(--color-neutral-800)]">
    {/* Hero: full viewport, layered mountain image with scroll parallax */}
    <section
      aria-labelledby="hero-h"
      data-parallax
      class="relative isolate flex min-h-[calc(100svh-65px)] flex-col overflow-hidden bg-white"
    >
      {/* Back layer: full image, sinks fastest */}
      <div data-parallax-speed="60" class="absolute inset-0 will-change-transform">
        <div class={ART_BOX}>
          <img
            src="/images/fcs/mountains-back-2000.webp"
            srcset={srcset("mountains-back")}
            sizes={ART_SIZES}
            alt=""
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[12%_100%] md:object-bottom"
          />
        </div>
      </div>
      {/* Soft glow behind the text only */}
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_18%_22%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.6)_45%,rgba(255,255,255,0)_75%)] max-md:bg-[radial-gradient(ellipse_120%_55%_at_30%_25%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.6)_50%,rgba(255,255,255,0)_80%)]"
      >
      </div>

      {/* Content layer: above all mountain layers, glides between the slow back and the near-static front ridge */}
      <div data-parallax-speed="30" class="relative z-40 flex-1 will-change-transform">
        <div class="fcs-container relative pb-28 pt-[4vh] md:pb-16 md:pt-[7vh]">
          {/* Brand line: FCS mark (64px = 2x its 32-cell grid), wordmark, full name */}
          <div class="flex items-center gap-4">
            <img src="/images/fcs/fcs.svg" alt="" width="64" height="64" class="size-16" />
            <span class="fcs-black text-2xl tracking-[0.18em] text-[var(--color-brand-deep-blue)]">{c.hero.brand.name}</span>
            <span aria-hidden="true" class="h-6 w-px bg-[var(--color-brand-deep-blue)]/25"></span>
            <span class="text-xs font-medium uppercase tracking-[0.28em] text-[#3a5981]">{c.hero.brand.full}</span>
          </div>
          <h1 id="hero-h" class="fcs-display mt-6 max-w-4xl text-balance md:mt-8">{c.hero.headline}</h1>
          <p class="fcs-lead mt-5 max-w-2xl md:mt-6">{c.hero.sub}</p>
          <div class="mt-7 flex flex-wrap items-center gap-3 md:mt-8">
            <a href={links.uniswap} target="_blank" rel="noopener" data-event="cta_get_fcs" data-location="hero" class="fcs-btn fcs-btn-blue">
              <img src={UNI} alt="" width="18" height="18" class="size-[18px] shrink-0" />
              {c.cta.uniswap}
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="shrink-0"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
            <a href={links.matcha} target="_blank" rel="noopener" data-event="cta_swap_matcha" data-location="hero" class="fcs-btn fcs-btn-ghost">
              <img src={MATCHA} alt="" width="18" height="18" class="size-[18px] shrink-0" />
              {c.cta.matcha}
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="shrink-0"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>

          {/* Live figures, sized to the content column */}
          <div class="mt-10 max-w-[46rem] overflow-hidden rounded-xl bg-[var(--color-brand-deep-blue)] text-white shadow-2xl shadow-[var(--color-brand-deep-blue)]/20 md:mt-12">
            <dl class="grid md:grid-cols-3">
              {
                figures.map((fig, i) => (
                  <div class={`px-5 py-2.5 md:py-4 ${i > 0 ? "border-t border-white/15 md:border-l md:border-t-0" : ""}`}>
                    <dt class="text-xs uppercase leading-snug tracking-wide text-[#d9dbe9]">{fig.label}</dt>
                    <dd class="mt-1 flex items-baseline gap-2">
                      <span class="fcs-black text-2xl tabular-nums" data-stat>{fig.value}</span>
                      <span class="text-xs text-[#d9dbe9]">{fig.unit}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
            <p class="flex items-center gap-2 border-t border-white/15 px-5 py-2 text-xs text-[#d9dbe9]">
              <span aria-hidden="true" class={`size-2 shrink-0 rounded-full ${stamp ? "bg-emerald-400" : "bg-[#94a2b8]"}`}></span>
              {stamp ?? c.hero.stampUnavailable}
            </p>
          </div>

          {/* AMA reminder: under the figures on smaller screens, floating bottom-right of the hero on wide ones */}
          {
            showAma && (
              <aside
                id="fcs-ama"
                data-ama-start={AMA_START}
                data-ama-local={c.ama.local}
                aria-labelledby="fcs-ama-title"
                class="relative mt-6 max-w-[46rem] rounded-2xl bg-white p-5 pr-12 shadow-2xl shadow-[var(--color-brand-deep-blue)]/15 ring-1 ring-[var(--color-neutral-200)] xl:absolute xl:bottom-16 xl:right-8 xl:mt-0 xl:w-[21rem]"
              >
                <button
                  type="button"
                  data-ama-close
                  aria-label={c.ama.close}
                  class="absolute right-3 top-3 inline-flex size-8 items-center justify-center rounded-full text-[var(--color-brand-titan-gray)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-brand-deep-blue)]"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
                <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-brand-swiss)]">
                  <span aria-hidden="true" class="relative flex size-2">
                    <span class="absolute inline-flex size-full rounded-full bg-[var(--color-brand-swiss)] opacity-60 motion-safe:animate-ping"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-[var(--color-brand-swiss)]"></span>
                  </span>
                  {c.ama.eyebrow}
                </p>
                <h2 id="fcs-ama-title" class="fcs-heading mt-2 text-[var(--color-brand-deep-blue)]">{c.ama.title}</h2>
                <p class="mt-1 text-sm text-[var(--color-neutral-650)]">
                  <time datetime={AMA_START}>{amaWhen}</time>
                  <span data-ama-local-time class="block text-[var(--color-brand-titan-gray)]"></span>
                </p>
                <a
                  href={AMA_CALENDAR}
                  target="_blank"
                  rel="noopener"
                  data-event="cta_ama_calendar"
                  data-location="hero-ama"
                  class="fcs-btn fcs-btn-blue mt-4 !min-h-9 !px-4 !text-[15px]"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M3.5 10h17M8 3v4M16 3v4M12 13v5M9.5 15.5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  {c.ama.cta}
                </a>
              </aside>
            )
          }
        </div>
      </div>

      {/* Front layer: the near ridge cut from the same image (aligned at rest), barely moves */}
      <div data-parallax-speed="6" class="pointer-events-none absolute inset-0 z-20 will-change-transform">
        <div class={ART_BOX}>
          <img
            src="/images/fcs/mountains-front-2000.webp"
            srcset={srcset("mountains-front")}
            sizes={ART_SIZES}
            alt=""
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[12%_100%] md:object-bottom"
          />
        </div>
      </div>
      {/* Fade into the page */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-30 h-28 bg-gradient-to-b from-transparent to-white"></div>
    </section>

    {/* What is FCS? */}
    <section id="what" aria-labelledby="what-h" class="fcs-section-y bg-white">
      <div class="fcs-container">
        <h2 id="what-h" class="fcs-title max-w-3xl text-balance">{c.what.headline}</h2>
        <ul class="mt-8 grid max-w-5xl gap-4 md:mt-10 md:grid-cols-2 md:gap-6">
          {
            c.what.cards.map((card, i) => (
              <li class="group flex h-full flex-col rounded-2xl border border-[var(--color-neutral-200)] bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[var(--color-brand-swiss)]/40 hover:shadow-lg hover:shadow-[var(--color-brand-deep-blue)]/10 md:p-7">
                <div class="flex items-center gap-3">
                  <PixelIcon name={whatIcons[i] ?? "pie"} size={32} class="size-8 shrink-0 transition-transform duration-300 group-hover:scale-110" />
                  <h3 class="fcs-black text-2xl leading-tight text-[var(--color-brand-deep-blue)]">{card.title}</h3>
                </div>
                <p class="mt-3 leading-relaxed text-[var(--color-neutral-650)]">{card.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Why hold FCS? */}
    <section id="why" aria-labelledby="why-h" class="fcs-section-y bg-[var(--color-neutral-100)]">
      <div class="fcs-container">
        <h2 id="why-h" class="fcs-title max-w-3xl text-balance">{c.why.headline}</h2>
        <p class="fcs-lead mt-4 max-w-2xl">{c.why.intro}</p>
        <ul class="mt-8 grid max-w-5xl gap-4 md:mt-10 md:grid-cols-2 md:gap-6">
          {
            c.why.cards.map((card, i) => (
              <li class="group flex h-full flex-col rounded-2xl border border-[var(--color-neutral-200)] bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[var(--color-brand-swiss)]/40 hover:shadow-lg hover:shadow-[var(--color-brand-deep-blue)]/10 md:p-7">
                <div class="flex items-center gap-3">
                  <PixelIcon name={whyIcons[i] ?? "coins"} size={32} class="size-8 shrink-0 transition-transform duration-300 group-hover:scale-110" />
                  <h3 class="fcs-black text-2xl leading-tight text-[var(--color-brand-deep-blue)]">{card.title}</h3>
                </div>
                <p class="mt-3 leading-relaxed text-[var(--color-neutral-650)]">{card.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Where to get FCS, contract check, proof links */}
    <section id="buy" aria-labelledby="buy-h" class="fcs-section-y bg-white">
      <div class="fcs-container">
        <h2 id="buy-h" class="fcs-title max-w-3xl text-balance">{c.buy.headline}</h2>
        <div class="mt-8 grid gap-4 md:mt-10 md:grid-cols-2">
          {
            buyOptions.map((o) => (
              <div class="flex flex-col rounded-xl bg-white p-6 ring-1 ring-[var(--color-neutral-200)] md:p-8">
                <h3 class="fcs-heading flex items-center gap-2 text-[var(--color-brand-deep-blue)]">
                  <img src={o.logo} alt="" width="24" height="24" class="size-6 shrink-0" />
                  {o.card.title}
                </h3>
                <p class="mt-2 text-[var(--color-neutral-650)]">{o.card.body}</p>
                <a href={o.href} target="_blank" rel="noopener" data-event={o.event} data-location="buy" class={`fcs-btn ${o.btn} mt-6 self-start`}>
                  <img src={o.logo} alt="" width="18" height="18" class="size-[18px] shrink-0" />
                  {o.action}
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="shrink-0"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </div>
            ))
          }
        </div>

        {/* Anti-scam callout */}
        <div class="mt-6 flex flex-col gap-2 rounded-xl border border-[var(--color-brand-swiss)]/30 bg-[#eef6fe] px-5 py-4 sm:flex-row sm:items-center sm:gap-4">
          <span class="flex shrink-0 items-center gap-2 font-bold text-[var(--color-brand-deep-blue)]">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0 text-[var(--color-brand-swiss)]">
              <path d="M12 2.5l7.5 3v6c0 4.6-3.2 8.6-7.5 10-4.3-1.4-7.5-5.4-7.5-10v-6l7.5-3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
              <path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {c.buy.contractCheck}
          </span>
          <span class="flex min-w-0 items-center gap-1">
            <a href={links.contract} target="_blank" rel="noopener" data-event="outbound_etherscan" data-location="buy-contract" class="break-all text-sm font-medium text-[var(--color-brand-deep-blue)] underline-offset-2 hover:underline">
              {FCS_ADDRESS}
            </a>
            <button
              type="button"
              data-copy={FCS_ADDRESS}
              data-copied-label={c.buy.copied}
              data-event="copy_contract"
              data-location="buy-contract"
              aria-label={c.buy.copy}
              title={c.buy.copy}
              class="inline-flex shrink-0 items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-[var(--color-brand-titan-gray)] hover:bg-white hover:text-[var(--color-brand-deep-blue)]"
            >
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M6 3h7a2 2 0 0 1 2 2v8H8a2 2 0 0 1-2-2V3Z"></path>
                <path d="M4 7h7a2 2 0 0 1 2 2v6H6a2 2 0 0 1-2-2V7Z"></path>
              </svg>
              <span data-copy-status class="sr-only" aria-live="polite"></span>
            </button>
          </span>
        </div>

        {/* Proof: each claim with its evidence */}
        <div class="mt-10 border-t border-[var(--color-neutral-300)] pt-8">
          <h3 class="fcs-heading text-[var(--color-brand-deep-blue)]">{c.buy.proof.title}</h3>
          <div class="mt-5 grid gap-6 sm:grid-cols-3">
            {
              proof.map((group) => (
                <div>
                  <p class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-brand-titan-gray)]">{group.label}</p>
                  <ul class="mt-2 flex flex-col gap-1.5">
                    {group.items.map((v) => (
                      <li>
                        <a href={v.url} target="_blank" rel="noopener" data-event="verify_link" data-location={`verify-${v.key}`} class="inline-flex items-center gap-1 font-medium text-[var(--color-brand-deep-blue)] underline-offset-4 hover:underline">
                          {v.label}
                          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="shrink-0"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* Why the Swiss franc: team text beside a pixel Swiss flag */}
    <section id="franc" aria-labelledby="franc-h" class="fcs-section-y overflow-hidden bg-[var(--color-neutral-100)]">
      <div class="fcs-container grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_384px] lg:gap-20">
        <div data-reveal class="w-fit lg:order-last">
          <PixelSwissFlag size={384} label={c.franc.flagAlt} class="size-48 drop-shadow-[0_24px_40px_rgba(218,41,28,0.18)] lg:size-96" />
        </div>
        <div>
          <h2 id="franc-h" class="fcs-title max-w-3xl text-balance">{c.franc.headline}</h2>
          <div class="mt-6 max-w-2xl space-y-5 text-lg leading-relaxed text-[var(--color-neutral-650)]">
            {c.franc.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <p class="fcs-black mt-8 max-w-2xl text-balance border-l-4 border-[#da291c] pl-5 text-2xl leading-snug text-[var(--color-brand-deep-blue)] md:text-3xl">
            {c.franc.closing}
          </p>
        </div>
      </div>
    </section>

    {/* What is ZCHF */}
    <section id="zchf" aria-labelledby="zchf-h" class="fcs-section-y bg-white">
      <div class="fcs-container">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
          {/* ZCHF coin logo (media kit coin_logo_frankencoin.svg), 64 / 128px: multiples of its 32-cell grid */}
          <img src="/images/fcs/zchf.svg" alt={c.zchf.coinAlt} width="128" height="128" loading="lazy" class="size-16 shrink-0 lg:order-last lg:size-32" />
          <div>
            <h2 id="zchf-h" class="fcs-title max-w-3xl text-balance">{c.zchf.headline}</h2>
            <p class="fcs-lead mt-4 max-w-2xl">{c.zchf.intro}</p>
          </div>
        </div>
        <ul class="mt-8 grid gap-8 md:mt-10 md:grid-cols-3 md:gap-10">
          {
            c.zchf.cards.map((p) => (
              <li>
                <h3 class="fcs-heading text-[var(--color-brand-deep-blue)]">{p.title}</h3>
                <p class="mt-2 text-[var(--color-neutral-650)]">{p.body}</p>
              </li>
            ))
          }
        </ul>
        {/* Pull quote: the link between ZCHF growth and FCS */}
        <figure class="relative mt-14 max-w-4xl rounded-2xl border-l-4 border-[var(--color-brand-swiss)] bg-[var(--color-neutral-100)] px-7 pb-7 pt-9 shadow-sm md:mt-16 md:px-10 md:pb-9 md:pt-11">
          <span aria-hidden="true" class="fcs-black absolute -top-6 left-6 text-7xl leading-none text-[var(--color-brand-swiss)] md:left-9">&ldquo;</span>
          <blockquote class="text-balance text-xl font-medium leading-snug text-[var(--color-brand-deep-blue)] md:text-2xl">{c.zchf.emphasis}</blockquote>
        </figure>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" aria-labelledby="faq-h" class="fcs-section-y bg-[var(--color-neutral-100)]">
      <div class="fcs-container">
        <h2 id="faq-h" class="fcs-title max-w-3xl text-balance">{c.faq.headline}</h2>
        <div class="mt-8 divide-y divide-[var(--color-neutral-200)] overflow-hidden rounded-xl bg-white ring-1 ring-[var(--color-neutral-200)] md:mt-10">
          {
            c.faq.items.map((q) => (
              <details>
                <summary class="flex cursor-pointer items-center justify-between gap-6 px-5 py-5 font-bold text-[var(--color-neutral-800)] hover:bg-[var(--color-neutral-100)] md:px-8">
                  <h3 class="text-base md:text-lg">{q.q}</h3>
                  <span aria-hidden="true" class="fcs-faq-icon text-2xl font-normal leading-none text-[var(--color-brand-titan-gray)] transition-transform">+</span>
                </summary>
                <p class="px-5 pb-6 text-[var(--color-neutral-650)] md:px-8">{q.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* Mobile sticky CTA bar */}
    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-[var(--color-neutral-200)] bg-white/95 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur md:hidden">
      <div class="grid grid-cols-2 gap-2">
        <a href={links.uniswap} target="_blank" rel="noopener" data-event="cta_get_fcs" data-location="mobile-bar" class="fcs-btn fcs-btn-blue w-full !gap-1.5 !px-2 !text-[15px]">
          <img src={UNI} alt="" width="16" height="16" class="size-4 shrink-0" />
          {c.cta.uniswap}
        </a>
        <a href={links.matcha} target="_blank" rel="noopener" data-event="cta_swap_matcha" data-location="mobile-bar" class="fcs-btn fcs-btn-ghost w-full !gap-1.5 !px-2 !text-[15px]">
          <img src={MATCHA} alt="" width="16" height="16" class="size-4 shrink-0" />
          {c.cta.matcha}
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  /*
   * FCS page behaviour (bundled by Astro, runs once):
   * 1. Scroll parallax for [data-parallax-speed] layers inside [data-parallax] (off with reduced motion).
   * 2. Outbound links: UTM passthrough from the page URL + a GA event (event name from data-event).
   * 3. Copy-to-clipboard for [data-copy].
   * 4. AMA reminder: removed at the AMA start time or when dismissed.
   * 5. Pixel flag reveal: lights up once when it scrolls into view.
   */
  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as { dataLayer?: unknown[]; gtag?: Gtag };
  // The site's GA snippet keeps gtag() module-scoped, so push to dataLayer the same way gtag.js expects.
  const track: Gtag =
    w.gtag ??
    function () {
      // eslint-disable-next-line prefer-rest-params
      (w.dataLayer ??= []).push(arguments);
    };

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 1. Parallax: each layer moves down by `speed` percent of the hero height while the hero scrolls out.
  const hero = document.querySelector<HTMLElement>("[data-parallax]");
  if (hero && !reducedMotion) {
    const layers = Array.from(hero.querySelectorAll<HTMLElement>("[data-parallax-speed]"));
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = hero.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -rect.top / rect.height));
      for (const el of layers) {
        const speed = Number(el.dataset.parallaxSpeed) || 0;
        el.style.transform = `translate3d(0, ${((progress * speed * rect.height) / 100).toFixed(1)}px, 0)`;
      }
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    update();
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
  }

  // 2. Outbound links: carry utm_* from the landing URL, and record the click.
  const utm = new URLSearchParams(location.search);
  const utmPairs = [...utm.entries()].filter(([k]) => k.startsWith("utm_"));
  const withUtm = (href: string) => {
    if (!utmPairs.length) return href;
    try {
      const url = new URL(href);
      for (const [k, v] of utmPairs) if (!url.searchParams.has(k)) url.searchParams.set(k, v);
      return url.toString();
    } catch {
      return href;
    }
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>("#fcs-page a[data-event]")) {
    a.href = withUtm(a.href);
    a.addEventListener("click", () => {
      track("event", a.dataset.event, { link_url: a.href, location: a.dataset.location, page: "fcs" });
    });
  }

  // 3. Copy the contract address.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("#fcs-page [data-copy]")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const status = btn.querySelector<HTMLElement>("[data-copy-status]");
        if (status) {
          status.textContent = btn.dataset.copiedLabel ?? "";
          status.classList.remove("sr-only");
          setTimeout(() => {
            status.textContent = "";
            status.classList.add("sr-only");
          }, 1500);
        }
        track("event", btn.dataset.event, { location: btn.dataset.location, page: "fcs" });
      } catch (e) {
        console.error("Copy failed", e);
      }
    });
  }

  // 4. AMA reminder: gone at the start time or once dismissed; shows the visitor's local time if it differs.
  const ama = document.getElementById("fcs-ama");
  if (ama) {
    const start = Date.parse(ama.dataset.amaStart ?? "");
    const key = `fcs-ama-dismissed-${ama.dataset.amaStart}`;
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(key) === "1";
    } catch {
      /* storage unavailable: just show it */
    }
    const remaining = start - Date.now();
    if (!(remaining > 0) || dismissed) {
      ama.remove();
    } else {
      if (remaining < 2 ** 31) setTimeout(() => ama.remove(), remaining);
      ama.querySelector("[data-ama-close]")?.addEventListener("click", () => {
        ama.remove();
        try {
          localStorage.setItem(key, "1");
        } catch {
          /* ignore */
        }
      });
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const out = ama.querySelector<HTMLElement>("[data-ama-local-time]");
      if (out && zone && zone !== "Europe/Zurich") {
        const fmt = (tz: string) =>
          new Intl.DateTimeFormat(document.documentElement.lang || undefined, { hour: "2-digit", minute: "2-digit", timeZone: tz }).format(start);
        if (fmt(zone) !== fmt("Europe/Zurich")) {
          const local = new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
            weekday: "short",
            hour: "2-digit",
            minute: "2-digit",
            timeZoneName: "short",
          }).format(start);
          out.textContent = (ama.dataset.amaLocal ?? "{time}").replace("{time}", local);
        }
      }
    }
  }

  // 5. Pixel flag reveal (hidden only once armed here, so it stays visible without JS or with reduced motion).
  const flag = document.querySelector<HTMLElement>("[data-reveal]");
  if (flag && !reducedMotion) {
    const box = flag.getBoundingClientRect();
    if (box.top >= innerHeight || box.bottom <= 0) {
      flag.dataset.reveal = "armed";
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          flag.dataset.reveal = "on";
          io.disconnect();
        },
        { threshold: 0.35 },
      );
      io.observe(flag);
    }
  }
</script>
