---
import Section from "../components/Layout/Section.astro";
import SectionHeader from "../components/Layout/SectionHeader.astro";
import Base from "../layouts/Base.astro";
import { getLanguageFromURL, loadContent, loadGlobalSharedContent, getLocalizedPath } from "../utils/i18n";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const index = await loadContent("index", currentLang);
const media = await loadGlobalSharedContent("media");
const faq = await loadContent("faq", currentLang);
import FeaturesContainer from "../components/FeaturesContainer/FeaturesContainer.astro";
import TabMenu from "../components/TabsMenu/TabMenu.astro";
import FoundationContainer from "../components/FoundationContainer/FoundationContainer.astro";
import TrustSecurityContainer from "../components/TrustSecurityContainer/TrustSecurityContainer.astro";
import FAQContainer from "../components/FAQContainer/FAQContainer.astro";
import AssetsContainer from "../components/AssetsContainer/AssetsContainer.astro";
import FlexStack from "../components/Layout/FlexStack.astro";
import BadgeContainer from "../components/BadgeContainer/BadgeContainer.astro";
import ExplanationCardsContainer from "../components/ExplanationCardsContainer/ExplanationCardsContainer.astro";
import MediaCarousel from "../components/MediaCarousel/MediaCarousel.astro";
import UseCasesGrid from "../components/UseCasesGrid/UseCasesGrid.astro";
import ExchangesGrid from "../components/ExchangesGrid/ExchangesGrid.astro";
import FCSLaunch from "../components/FCSLaunch/FCSLaunch.astro";
import Calculator from "../components/Calculator/Calculator.astro";
import AudienceDoors from "../components/AudienceDoors/AudienceDoors.astro";
import TrustStrip from "../components/TrustStrip/TrustStrip.astro";
import StickyCTA from "../components/StickyCTA/StickyCTA.astro";
import { getCalcData } from "../utils/calcStats";
import { formatPct } from "../utils/fcsStats";

export const prerender = false;

async function getFrankencoinInfo() {
  try {
    let response = await fetch(
      "https://api.frankencoin.com/ecosystem/frankencoin/info"
    );
    if (!response.ok) throw new Error("Failed to fetch quote");
    return response.json();
  } catch (error) {
    console.error("Error fetching data:", error);
    return null;
  }
}

const [frankencoinInfo, calc] = await Promise.all([getFrankencoinInfo(), getCalcData()]);
const rateLabel = formatPct(calc.current.rate, 2);

type StatMeta = { label?: string; unit?: string; href?: string; value?: string };

function findStat(id: string): StatMeta {
  return ((index.stats ?? []).find((s: any) => s.id === id) || {}) as StatMeta;
}

function formatAmount(n: number) {
  if (typeof n !== "number" || Number.isNaN(n)) return "0";
  return n.toFixed(0).replace(/\d{1,3}(?=(\d{3})+(?!\d))/g, "$&'");
}

const s0 = findStat("savingsRate");
const s1 = findStat("totalSupply");
const s2 = findStat("totalValueLocked");
const s4 = findStat("compliance");

// Helper to localize internal hrefs
function localizeHref(href: string | undefined, fallback: string): string {
  const path = href ?? fallback;
  // Only localize internal paths (not external URLs or anchors)
  if (path.startsWith('/') && !path.startsWith('//') && !path.includes('://')) {
    return getLocalizedPath(path, currentLang);
  }
  return path;
}

const stats: Option[] = frankencoinInfo
  ? [
      {
        label: s0.label ?? "Savings rate",
        value: rateLabel,
        unit: s0.unit,
        href: localizeHref(s0.href, "/save-invest"),
      },
      {
        label: s1.label ?? "Money circulating",
        value: formatAmount(frankencoinInfo.token?.supply ?? 0),
        unit: s1.unit,
        href: s1.href,
      },
      {
        label: s2.label ?? "Collateral value",
        value: formatAmount(frankencoinInfo.tvl?.chf ?? 0),
        unit: s2.unit,
        href: s2.href,
      },
      {
        label: s4.label ?? "Fully Compliant",
        value: s4.value ?? "Swiss Law & MiCAR",
        href: localizeHref(s4.href, "/compliance"),
      },
    ]
  : [];

const doors = index.doors.items.map((d: any) => ({ ...d, stat: d.stat && { ...d.stat, value: d.stat.value.replace("{rate}", rateLabel) } }));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=300');
---


---

<Base>
  <h1 class="sr-only">Frankencoin — Swiss Franc Stablecoin (ZCHF)</h1>
  <Section
    id="main-page-header"
    variant="accent"
    align="center"
    pad="xxs"
    imgUrl={index.hero.image}
  >
    <div data-hero class="min-h-[70vh] md:min-h-screen flex flex-col justify-center gap-14 md:gap-20 pt-6 md:pt-20 pb-4">
      <SectionHeader
        title={index.hero.title}
        subtitle={index.hero.subtitle}
        margin="none"
        size="display"
        align="left"
        padding="xl"
        cta={[
          { label: index.hero.cta.label, href: localizeHref(index.hero.cta.href, "/start"), variant: "primary" },
          { label: index.hero.cta_buttons[1].label, href: index.hero.cta_buttons[1].href, variant: "secondary", external: true },
        ]}
      />

      <div class="flex flex-col items-center gap-6">
        <BadgeContainer options={stats} />

        <a
          href={index.hero.cta_buttons[0].href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-[var(--color-brand-deep-blue)] ty-body-2 font-semibold hover:text-[var(--color-brand-swiss)] transition-colors"
        >
          <span>{index.hero.cta_buttons[0].label}</span>
          <img src="/images/Arrow.svg" loading="lazy" alt="" class="w-3 h-3 pointer-events-none" />
        </a>

        {index.hero.announcement && (
          <a
            href={localizeHref(index.hero.announcement.href, "/fcs")}
            class="group inline-flex max-w-full items-center gap-3 rounded-full border border-[var(--color-brand-deep-blue)] px-5 py-2.5 transition-all hover:-translate-y-0.5 hover:shadow-md"
          >
            <span class="rounded-full bg-[var(--color-brand-swiss)] px-2.5 py-0.5 ty-2xs font-bold uppercase tracking-wide text-[var(--color-white)]">{index.hero.announcement.eyebrow}</span>
            <span class="ty-body-3 font-bold text-[var(--color-brand-deep-blue)]">{index.hero.announcement.label}</span>
            <img src="/images/Arrow.svg" loading="lazy" alt="" class="w-3 h-3 shrink-0 pointer-events-none motion-safe:group-hover:translate-x-0.5 transition-transform" />
          </a>
        )}
      </div>
    </div>
  </Section>

  <Section id="doors" eyebrow={index.doors.eyebrow} title={index.doors.title} pad="xs" align="center" margin="mt-8">
    <div class="text-left"><AudienceDoors doors={doors} /></div>
  </Section>

  <Section id="calculator" variant="accent" pad="xs">
    <div class="max-w-5xl mx-auto"><Calculator /></div>
  </Section>

  <Section
    id="how-does-it-work"
    eyebrow={index.how_simple.eyebrow}
    title={index.how_simple.title}
    subtitle={index.how_simple.subtitle}
    pad="xs"
    align="center"
  >
    <div class="text-left"><ExplanationCardsContainer cards={index.how_simple.cards} /></div>
    <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 ty-body-2 font-bold">
      <a href={getLocalizedPath('/what-is-frankencoin', currentLang)} class="text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]">{index.what_is.title} →</a>
      <a href={getLocalizedPath('/use-cases', currentLang)} class="text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]">{index.core_features.more_link.label} →</a>
      <a href={getLocalizedPath('/frontends', currentLang)} class="text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]">{index.core_features.frontendsCallout.ctaLabel} →</a>
    </div>
  </Section>

  <FCSLaunch content={index.fcs_launch} lang={currentLang} />

  <Section id="trust-security" eyebrow={index.trust_strip.eyebrow} title={index.trust_strip.title} pad="xs" align="center">
    <div class="text-left"><TrustStrip items={index.trust_strip.items} /></div>
    <a href={localizeHref(index.trust_strip.more.href, "/compliance")} class="inline-flex items-center gap-2 mt-6 ty-body-2 font-bold text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]">
      {index.trust_strip.more.label}
      <img src="/images/Arrow.svg" loading="lazy" alt="" class="w-3 h-3" />
    </a>
  </Section>

  <Section
    id="in-the-media"
    eyebrow={index.in_the_media.eyebrow}
    title={index.in_the_media.title}
    subtitle={index.in_the_media.subtitle}
    variant="accent"
    pad="xs"
  >
    <MediaCarousel articles={media.articles} videos={media.videos} />
  </Section>

  <Section
    id="faq"
    title={faq.title}
    layout="split"
    headerPosition="items-start"
    pad="xs"
  >
    <FAQContainer faqs={faq} slot="aside" />
  </Section>

  <StickyCTA label={index.sticky.label} sub={index.sticky.sub} href={index.sticky.href} />
</Base>
