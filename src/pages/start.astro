---
/*
 * /start — the "Participate" page: pick a goal, run the calculator, do it in three steps.
 * Copy: src/content/en/start.json. Live data: Calculator component (utils/calcStats.ts).
 */
import Base from "../layouts/Base.astro";
import Section from "../components/Layout/Section.astro";
import Calculator from "../components/Calculator/Calculator.astro";
import Steps from "../components/Steps/Steps.astro";
import TrustStrip from "../components/TrustStrip/TrustStrip.astro";
import StickyCTA from "../components/StickyCTA/StickyCTA.astro";
import { getLanguageFromURL, loadContent, getLocalizedPath } from "../utils/i18n";

export const prerender = false;

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("start", lang);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description}>
  <Section id="start-hero" variant="accent" pad="xs" margin="mt-16">
    <div data-hero class="pt-8 md:pt-12 max-w-3xl mx-auto text-center flex flex-col gap-4">
      <p class="ty-subtitle">{c.hero.eyebrow.toUpperCase()}</p>
      <h1 class="ty-large-title text-[var(--color-brand-deep-blue)] m-0">{c.hero.title}</h1>
      <p class="ty-body-1 text-[var(--color-neutral-650)]">{c.hero.subtitle}</p>
    </div>
    <div class="mt-10 md:mt-14 max-w-5xl mx-auto">
      <Calculator compact defaultGoal="save" />
    </div>
  </Section>

  <Section id="paths" title={c.paths.title} pad="xs" align="center">
    <div class="grid md:grid-cols-2 gap-4 lg:gap-6 text-left max-w-5xl mx-auto">
      {["save", "invest"].map((k) => {
        const p = c.paths[k];
        const ext = p.href.startsWith("http");
        return (
          <div class="flex flex-col gap-4 rounded-2xl border border-[var(--color-gray-20)] p-6 lg:p-8 bg-[var(--color-white)]">
            <p class="ty-xs tracking-wider font-bold text-[var(--color-brand-swiss)]">{p.eyebrow.toUpperCase()}</p>
            <h3 class="ty-title-1 font-black text-[var(--color-brand-deep-blue)] m-0">{p.title}</h3>
            <p class="ty-body-2 text-[var(--color-neutral-650)]">{p.body}</p>
            <ul class="flex flex-col gap-2 ty-body-3 text-[var(--color-neutral-700)]">
              {p.bullets.map((b: string) => (
                <li class="flex gap-2"><span class="text-[var(--color-brand-swiss)] font-black">✓</span><span>{b}</span></li>
              ))}
            </ul>
            <a href={href(p.href)} target={ext ? "_blank" : undefined} rel={ext ? "noopener noreferrer" : undefined}
              class="mt-auto inline-flex items-center justify-center rounded-full bg-[var(--color-brand-deep-blue)] hover:bg-[var(--color-blue-39)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">
              {p.cta}
            </a>
          </div>
        );
      })}
    </div>
  </Section>

  <Section id="steps" variant="accent" title={c.steps.title} subtitle={c.steps.subtitle} pad="xs" align="center">
    <div class="text-left max-w-5xl mx-auto">
      <Steps steps={c.steps.items} />
      <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 ty-body-3">
        {c.steps.items.filter((s: any) => s.alt).map((s: any) => (
          <a href={s.alt.href} target="_blank" rel="noopener noreferrer" class="text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)] font-bold underline-offset-2 hover:underline">{s.alt.label} →</a>
        ))}
      </div>
    </div>
  </Section>

  <Section id="trust" title={c.trust.title} pad="xs" align="center">
    <div class="max-w-5xl mx-auto text-left"><TrustStrip items={c.trust.items} /></div>
  </Section>

  <Section id="faq" variant="accent" title={c.faq.title} pad="xs" align="center">
    <div class="max-w-3xl mx-auto text-left divide-y divide-[var(--color-gray-20)] border border-[var(--color-gray-20)] rounded-3xl px-6 md:px-8 py-2 bg-[var(--color-white)]">
      {c.faq.items.map((f: any) => (
        <div x-data="{ open: false }" class="py-4">
          <button class="w-full flex justify-between items-center gap-4 text-left" x-on:click="open = !open" :aria-expanded="open.toString()">
            <span class="ty-body-2 font-bold text-[var(--color-brand-deep-blue)]">{f.q}</span>
            <span aria-hidden="true" class="text-2xl leading-none transition-transform" :class="open ? 'rotate-45' : ''">+</span>
          </button>
          <p x-show="open" x-transition class="mt-3 ty-body-3 text-[var(--color-neutral-650)]">{f.a}</p>
        </div>
      ))}
    </div>
  </Section>

  <StickyCTA label={c.sticky.label} sub={c.sticky.sub} href="https://app.frankencoin.com/savings" />
</Base>
